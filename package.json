    "@google/genai": "^2.24.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "border-beam": "^1.4.1",
    "bot-avatars": "^0.1.1",
    "thinking-orbs": "^0.3.2",
    "voice-glow": "^0.2.1"
  }
}
